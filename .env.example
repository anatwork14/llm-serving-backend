# setup.ps1 creates .env automatically with random secrets.
# If you configure this manually, change every "change-me" value.

# Service authentication
BACKEND_API_KEY=change-me-backend-key
ADMIN_API_KEY=change-me-admin-key
WEBUI_SECRET_KEY=change-me-webui-secret

# Internal llama.cpp authentication
LLAMA_API_KEY=change-me-llama-key
LLAMA_BASE_URL=http://llm:8080/v1
MODEL_ALIAS=bonsai-2-27b
UPSTREAM_MODEL=

# Bonsai 2 model. First launch downloads these into the persistent model-data volume.
HF_MODEL_REPO=prism-ml/Ternary-Bonsai-2-27B-gguf
MODEL_FILE=Ternary-Bonsai-2-27B-PQ2_0.gguf
MMPROJ_FILE=Ternary-Bonsai-2-27B-mmproj-Q8_0.gguf
# Public repo: token is normally unnecessary.
HF_TOKEN=

# RTX 3060 12 GB defaults
LLM_CONTEXT_SIZE=16384
LLM_PARALLEL_SLOTS=2
LLM_GPU_LAYERS=99
LLM_IMAGE_MAX_TOKENS=1024
LLM_ENABLE_VISION=true

# Pinned Prism llama.cpp prebuilt release used by docker/llm.Dockerfile.
PRISM_LLAMA_TAG=prism-b10709-9a9394a
PRISM_CUDA_VERSION=12.4

# PostgreSQL
POSTGRES_USER=llm
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=llm
DATABASE_URL=postgresql+asyncpg://llm:change-me-db-password@db:5432/llm

# User/context behavior
DEFAULT_USER_ID=dad
ALLOWED_USER_IDS=
ALLOWED_ROLES=user,admin
SYSTEM_PROMPT_PATH=config/system_prompt.txt
MEMORY_TOP_K=4
RAG_TOP_K=4
RECENT_MESSAGE_LIMIT=10
SUMMARY_TRIGGER_MESSAGES=20
SUMMARY_KEEP_RECENT=8
MAX_CONTEXT_ITEM_CHARS=1600

# Semantic memory/RAG runs on CPU so the RTX 3060 stays dedicated to llama.cpp.
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# Optional comma-separated OpenAI tool/function names. Empty = allow all forwarded tools.
ALLOWED_TOOL_NAMES=

# Bounded serving / backpressure
LLM_MAX_CONCURRENT_REQUESTS=2
LLM_MAX_BACKGROUND_REQUESTS=1
LLM_MAX_QUEUE_SIZE=16
LLM_QUEUE_TIMEOUT_SECONDS=120

# Networking / logging
# Keep localhost for the default private setup. Set 0.0.0.0 only when you intentionally
# want other machines to reach the OpenAI-compatible FastAPI gateway.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
REQUEST_TIMEOUT_SECONDS=600
LOG_LEVEL=INFO
