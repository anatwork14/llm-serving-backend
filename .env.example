# Service authentication. Change every secret before first run.
BACKEND_API_KEY=change-me-backend-key
ADMIN_API_KEY=change-me-admin-key
WEBUI_SECRET_KEY=change-me-webui-secret

# PostgreSQL (Docker Compose)
POSTGRES_USER=llm
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=llm
DATABASE_URL=postgresql+asyncpg://llm:change-me-db-password@db:5432/llm

# Prism/llama.cpp runs natively on the Windows host.
LLAMA_BASE_URL=http://host.docker.internal:8080/v1
LLAMA_API_KEY=sk-no-key-required
MODEL_ALIAS=bonsai-2-27b
# Leave blank unless llama.cpp requires a specific upstream model id.
UPSTREAM_MODEL=

# User/context behavior
DEFAULT_USER_ID=dad
ALLOWED_USER_IDS=
ALLOWED_ROLES=user,admin
SYSTEM_PROMPT_PATH=config/system_prompt.txt
MEMORY_TOP_K=4
RAG_TOP_K=4
RECENT_MESSAGE_LIMIT=10
SUMMARY_TRIGGER_MESSAGES=20
SUMMARY_KEEP_RECENT=8
MAX_CONTEXT_ITEM_CHARS=1600

# Semantic memory/RAG. Runs on CPU so your RTX 3060 stays dedicated to llama.cpp.
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# Optional comma-separated OpenAI tool/function names. Empty = allow all forwarded tools.
ALLOWED_TOOL_NAMES=

# Networking / logging
REQUEST_TIMEOUT_SECONDS=600
LOG_LEVEL=INFO
